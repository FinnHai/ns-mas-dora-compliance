# DORA Szenario-Plattform – Umgebungsvariablen
# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird nicht versioniert (sensible Daten).

# LLM (mindestens eines erforderlich)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Neo4j (lokal oder Remote)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: NVD API für CVE-Validierung (höheres Rate-Limit)
# NVD_API_KEY=
